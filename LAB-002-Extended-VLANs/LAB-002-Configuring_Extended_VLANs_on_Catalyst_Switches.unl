<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<lab name="LAB-002-Configuring_Extended_VLANs_on_Catalyst_Switches" id="d1e0bb9b-4239-45f7-8aae-eee0466a2266" version="1" scripttimeout="300" lock="0" author="Raman Kumar Shakya">
  <description>Set Sw1 to VTP transparent, create extended VLANs 2010-2040, assign access ports and verify with show commands.</description>
  <topology>
    <nodes>
      <node id="1" name="Sw1" type="iol" template="iol" image="i86bi_linux_l2-adventerprisek9-ms.SSA.high_iron_20190423.bin" ethernet="2" nvram="1024" ram="512" serial="0" console="" delay="0" icon="Router-2D-Gen-White-S.svg" config="0" left="273" top="384">
        <interface id="16" name="e0/1" type="ethernet" network_id="1"/>
      </node>
      <node id="2" name="Sw2" type="iol" template="iol" image="i86bi_linux_l2-adventerprisek9-ms.SSA.high_iron_20190423.bin" ethernet="2" nvram="1024" ram="512" serial="0" console="" delay="0" icon="Router-2D-Gen-White-S.svg" config="0" left="825" top="384">
        <interface id="16" name="e0/1" type="ethernet" network_id="1"/>
      </node>
    </nodes>
    <networks>
      <network id="1" type="bridge" name="Net-Sw1iface_16" left="312" top="442" visibility="0" icon="lan.png"/>
    </networks>
  </topology>
