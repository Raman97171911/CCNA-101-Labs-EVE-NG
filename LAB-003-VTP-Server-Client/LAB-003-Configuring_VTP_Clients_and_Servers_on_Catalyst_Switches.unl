<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<lab name="LAB-003-Configuring_VTP_Clients_and_Servers_on_Catalyst_Switches" id="e56b60e2-d0be-45a2-857d-ec225fbc6b04" version="1" scripttimeout="300" lock="0" author="Raman Kumar Shakya">
  <description>Sw1 VTP server, Sw2 VTP client (domain CISCO), 802.1Q trunk, VLAN 10 end to end with an R1-R3 ping.</description>
  <topology>
    <nodes>
      <node id="1" name="Sw1" type="iol" template="iol" image="i86bi_linux_l2-adventerprisek9-ms.SSA.high_iron_20190423.bin" ethernet="2" nvram="1024" ram="512" serial="0" console="" delay="0" icon="Router-2D-Gen-White-S.svg" config="0" left="430" top="384">
        <interface id="16" name="e0/1" type="ethernet" network_id="1"/>
        <interface id="32" name="e0/2" type="ethernet" network_id="2"/>
      </node>
      <node id="2" name="Sw2" type="iol" template="iol" image="i86bi_linux_l2-adventerprisek9-ms.SSA.high_iron_20190423.bin" ethernet="2" nvram="1024" ram="512" serial="0" console="" delay="0" icon="Router-2D-Gen-White-S.svg" config="0" left="790" top="384">
        <interface id="16" name="e0/1" type="ethernet" network_id="1"/>
        <interface id="32" name="e0/2" type="ethernet" network_id="3"/>
      </node>
      <node id="3" name="R1" type="iol" template="iol" image="i86bi_linux_l3-adventerprisek9-ms.154-2.T4.bin" ethernet="1" nvram="1024" ram="512" serial="0" console="" delay="0" icon="Router.png" config="0" left="130" top="384">
        <interface id="0" name="e0/0" type="ethernet" network_id="2"/>
      </node>
      <node id="4" name="R3" type="iol" template="iol" image="i86bi_linux_l3-adventerprisek9-ms.154-2.T4.bin" ethernet="1" nvram="1024" ram="512" serial="0" console="" delay="0" icon="Router.png" config="0" left="1090" top="384">
        <interface id="0" name="e0/0" type="ethernet" network_id="3"/>
      </node>
    </nodes>
    <networks>
      <network id="1" type="bridge" name="Net-Sw1-Sw2" left="610" top="442" visibility="0" icon="lan.png"/>
      <network id="2" type="bridge" name="Net-R1-Sw1" left="280" top="442" visibility="0" icon="lan.png"/>
      <network id="3" type="bridge" name="Net-Sw2-R3" left="940" top="442" visibility="0" icon="lan.png"/>
    </networks>
  </topology>
